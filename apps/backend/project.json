{
  "name": "backend",
  "sourceRoot": "apps/backend",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project backend.csproj",
        "cwd": "apps/backend"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet watch --project backend.csproj",
        "cwd": "apps/backend"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build backend.csproj",
        "cwd": "apps/backend"
      }
    },
    "docker-build-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t tomcheese/megu-chat-backend . -f Dockerfile.app",
        "cwd": "apps/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test",
        "cwd": "apps/backend-tests"
      }
    }
  }
}
