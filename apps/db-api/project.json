{
  "name": "db-api",
  "sourceRoot": "apps/db-api",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run fastapi dev",
        "cwd": "apps/db-api"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -c \"from app.sql.session import migrate_database; migrate_database()\"",
        "cwd": "apps/db-api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/db-api"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t tomcheese/megu-chat-db-api .",
        "cwd": "apps/db-api"
      }
    }
  }
}
