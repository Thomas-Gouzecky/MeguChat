{
  "name": "mcp-server",
  "sourceRoot": "apps/mcp-server",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run -m app.main",
        "cwd": "apps/mcp-server"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run mcp dev app/main.py",
        "cwd": "apps/mcp-server",
        "env": {
          "PYTHONPATH": "."
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest tests/",
        "cwd": "apps/mcp-server",
        "env": {
          "MCP_HOST": "127.0.0.1",
          "MCP_PORT": "8023"
        }
      }
    },
    "docker-build-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t tomcheese/meguchat-mcp-server-repo .",
        "cwd": "apps/mcp-server"
      }
    },
    "docker-run-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker run --rm --name meguchat-mcp-server -p 8023:8023 --env MCP_HOST --env MCP_PORT --env BACKEND_GATEWAY_URL -d tomcheese/meguchat-mcp-server-repo",
        "cwd": "apps/mcp-server"
      }
    },
    "docker-run-mcp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker run --rm --name meguchat-mcp-server -p 8023:8023 --env MCP_HOST --env MCP_PORT --env BACKEND_GATEWAY_URL -d tomcheese/meguchat-mcp-server-repo",
        "cwd": "apps/mcp-server"
      }
    },
    "docker-stop-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker stop meguchat-mcp-server",
        "cwd": "apps/mcp-server"
      }
    }
  }
}
