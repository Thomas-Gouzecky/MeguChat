{
  "name": "mcp-server",
  "sourceRoot": "apps/mcp-server",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run app/main.py",
        "cwd": "apps/mcp-server"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mcp dev app/main.py",
        "cwd": "apps/mcp-server"
      }
    },
    "docker-build-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t tomcheese/meguchat-mcp-server-repo .",
        "cwd": "apps/mcp-server"
      }
    },
    "docker-run-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker run --rm -p 8023:8023 tomcheese/meguchat-mcp-server-repo",
        "cwd": "apps/mcp-server"
      }
    }
  }
}
